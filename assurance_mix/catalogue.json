{
  "version": 1,
  "principles": [
    {"id": "safety", "short": "Safety", "name": "Safety, security and robustness"},
    {"id": "transparency", "short": "Transparency", "name": "Appropriate transparency and explainability"},
    {"id": "fairness", "short": "Fairness", "name": "Fairness"},
    {"id": "accountability", "short": "Accountability", "name": "Accountability and governance"},
    {"id": "contestability", "short": "Contestability", "name": "Contestability and redress"}
  ],
  "likelihood": {
    "scores": [0, 1, 2, 3, 4, 5],
    "probabilities": [0, 0.025, 0.125, 0.35, 0.65, 0.9],
    "bands": ["under 5%", "5 to 20%", "20 to 50%", "50 to 80%", "over 80%"]
  },
  "riskBands": [
    {"max": 4, "label": "Low"},
    {"max": 9, "label": "Medium"},
    {"max": 15, "label": "High"},
    {"max": 25, "label": "Very high"}
  ],
  "questions": [
    {
      "id": "stakes",
      "label": "What does its output decide?",
      "options": [
        {"id": "advisory", "label": "Nothing about individuals (back-office work or general advice)", "L": {}, "I": {}},
        {"id": "shapes", "label": "It shapes decisions about people (ranking, pricing, flagging)", "L": {}, "I": {"safety": 0.5, "transparency": 1, "fairness": 1.5, "accountability": 1, "contestability": 1}},
        {"id": "significant", "label": "It decides access to jobs, credit, housing or services", "L": {}, "I": {"safety": 1, "transparency": 2, "fairness": 2.5, "accountability": 2, "contestability": 2.5}},
        {"id": "safety", "label": "It could cause physical harm (equipment, vehicles, health)", "L": {}, "I": {"safety": 3, "transparency": 1, "fairness": 1, "accountability": 2.5, "contestability": 1}}
      ]
    },
    {
      "id": "autonomy",
      "label": "How much does a person check?",
      "options": [
        {"id": "suggests", "label": "A person decides; the system only suggests", "L": {}, "I": {}},
        {"id": "approves", "label": "A person signs off each output, usually quickly", "L": {"safety": 0.5, "transparency": 0.5, "fairness": 0.5, "contestability": 0.5}, "I": {}},
        {"id": "automated", "label": "Fully automated, with no person in the loop", "L": {"safety": 1, "transparency": 1, "fairness": 1, "accountability": 0.5, "contestability": 1.5}, "I": {}}
      ]
    },
    {
      "id": "model",
      "label": "What kind of model is it?",
      "options": [
        {"id": "rules", "label": "Rules or simple statistics", "L": {"safety": 0.5, "fairness": 0.5}, "I": {}},
        {"id": "ml", "label": "A machine-learning model", "L": {"safety": 1, "transparency": 1.5, "fairness": 1.5, "accountability": 0.5}, "I": {}},
        {"id": "genai", "label": "A general-purpose or generative model", "L": {"safety": 2, "transparency": 2, "fairness": 1.5, "accountability": 1, "contestability": 0.5}, "I": {}}
      ]
    },
    {
      "id": "data",
      "label": "What data does it use?",
      "options": [
        {"id": "none", "label": "No personal data", "L": {}, "I": {}},
        {"id": "personal", "label": "Personal data", "L": {"transparency": 0.5, "fairness": 0.5, "accountability": 0.5}, "I": {"transparency": 0.5}},
        {"id": "special", "label": "Special category data (for example health or ethnicity)", "L": {"transparency": 0.5, "fairness": 1, "accountability": 1}, "I": {"safety": 0.5, "transparency": 0.5, "fairness": 1}}
      ]
    },
    {
      "id": "affected",
      "label": "Who is affected?",
      "options": [
        {"id": "staff", "label": "Staff only", "L": {}, "I": {}},
        {"id": "customers", "label": "Customers who chose to deal with you", "L": {}, "I": {"transparency": 0.5, "fairness": 0.5, "contestability": 0.5}},
        {"id": "public", "label": "The public, including people in vulnerable circumstances", "L": {}, "I": {"safety": 0.5, "transparency": 1, "fairness": 1, "accountability": 0.5, "contestability": 1}}
      ]
    },
    {
      "id": "source",
      "label": "Where does it come from?",
      "options": [
        {"id": "inhouse", "label": "Built in-house", "L": {}, "I": {}},
        {"id": "full", "label": "Bought in, with full access to the model and data", "L": {"accountability": 0.5}, "I": {}},
        {"id": "outputs", "label": "Bought in, outputs only: you can test it but not look inside", "L": {"transparency": 1, "fairness": 0.5, "accountability": 1}, "I": {}},
        {"id": "docs", "label": "Bought in, documentation only: no testing before go-live", "L": {"safety": 0.5, "transparency": 1.5, "fairness": 1, "accountability": 1.5}, "I": {}}
      ]
    },
    {
      "id": "change",
      "label": "Does it change after go-live?",
      "options": [
        {"id": "fixed", "label": "No, it is fixed once deployed", "L": {}, "I": {}},
        {"id": "retrained", "label": "It is retrained from time to time", "L": {"safety": 0.5, "fairness": 0.5, "accountability": 0.5}, "I": {}},
        {"id": "learning", "label": "It keeps learning from live data", "L": {"safety": 1, "transparency": 0.5, "fairness": 1, "accountability": 1}, "I": {}}
      ]
    },
    {
      "id": "stage",
      "label": "How far is it being rolled out?",
      "options": [
        {"id": "pilot", "label": "Pilot: a few hundred cases, closely watched", "L": {}, "I": {}},
        {"id": "rollout", "label": "Limited roll-out: thousands of cases", "L": {}, "I": {"safety": 0.5, "transparency": 0.5, "fairness": 0.5, "accountability": 0.5, "contestability": 0.5}},
        {"id": "scale", "label": "Full scale: hundreds of thousands of cases", "L": {}, "I": {"safety": 1, "transparency": 1, "fairness": 1, "accountability": 1, "contestability": 1}}
      ]
    }
  ],
  "stages": [
    {"id": "design", "label": "Design"},
    {"id": "test", "label": "Before go-live"},
    {"id": "live", "label": "In operation"}
  ],
  "techniques": [
    {
      "id": "risk", "name": "Risk assessment", "source": "DSIT", "stage": "design", "spectrum": 0.15, "independent": false,
      "cost": 4, "weeks": 2,
      "coverage": {"safety": 0.25, "transparency": 0.15, "fairness": 0.2, "accountability": 0.3, "contestability": 0.15},
      "blurb": "A structured look at what could go wrong in development and use: bias, privacy, misuse, reputation."
    },
    {
      "id": "aia", "name": "Algorithmic impact assessment", "source": "DSIT", "stage": "design", "spectrum": 0.2, "independent": false,
      "cost": 9, "weeks": 4,
      "coverage": {"safety": 0.15, "transparency": 0.2, "fairness": 0.35, "accountability": 0.2, "contestability": 0.3},
      "blurb": "Anticipates wider effects on people, equality and rights, ideally with input from those affected."
    },
    {
      "id": "dpia", "name": "Data protection impact assessment", "source": "UK GDPR", "stage": "design", "spectrum": 0.25, "independent": false,
      "cost": 6, "weeks": 3,
      "coverage": {"safety": 0.1, "transparency": 0.3, "fairness": 0.2, "accountability": 0.3, "contestability": 0.25},
      "needsData": true,
      "blurb": "The UK GDPR assessment for processing likely to be high risk to people; the ICO expects one for most AI that uses personal data."
    },
    {
      "id": "docs", "name": "Model and data documentation", "source": "Common practice", "stage": "design", "spectrum": 0.45, "independent": false,
      "cost": 6, "weeks": 2,
      "coverage": {"safety": 0.1, "transparency": 0.4, "fairness": 0.1, "accountability": 0.3, "contestability": 0.1},
      "access": {"full": 1, "outputs": 0.6, "docs": 0.6},
      "blurb": "Model cards and data sheets: what the system is for, how it was built and tested, and its known limits."
    },
    {
      "id": "supplier", "name": "Supplier due diligence", "source": "Common practice", "stage": "design", "spectrum": 0.3, "independent": false,
      "cost": 5, "weeks": 2,
      "coverage": {"safety": 0.15, "transparency": 0.25, "fairness": 0.15, "accountability": 0.35, "contestability": 0.15},
      "boughtInOnly": true,
      "blurb": "Questions, evidence and contract terms for a bought-in system: testing rights, incident notice, audit access."
    },
    {
      "id": "aims", "name": "Certified AI management system (ISO/IEC 42001)", "source": "Standard", "stage": "design", "spectrum": 0.4, "independent": true,
      "cost": 45, "weeks": 14,
      "coverage": {"safety": 0.1, "transparency": 0.1, "fairness": 0.1, "accountability": 0.5, "contestability": 0.2},
      "requires": ["risk", "aia"],
      "blurb": "Organisation-wide AI governance certified by an accredited body. Builds on risk and impact assessment."
    },
    {
      "id": "biasInternal", "name": "Internal bias audit", "source": "DSIT", "stage": "test", "spectrum": 0.75, "independent": false,
      "cost": 10, "weeks": 3,
      "coverage": {"safety": 0, "transparency": 0.05, "fairness": 0.4, "accountability": 0, "contestability": 0.05},
      "access": {"full": 1, "outputs": 0.7, "docs": 0},
      "blurb": "Your own team tests inputs and outputs for unfair differences between groups."
    },
    {
      "id": "biasIndependent", "name": "Independent bias audit", "source": "DSIT", "stage": "test", "spectrum": 0.8, "independent": true,
      "cost": 24, "weeks": 5,
      "coverage": {"safety": 0, "transparency": 0.1, "fairness": 0.55, "accountability": 0.1, "contestability": 0.05},
      "access": {"full": 1, "outputs": 0.7, "docs": 0},
      "blurb": "An external assurer tests for unfair bias. Needs access to data and outputs."
    },
    {
      "id": "performance", "name": "Performance and robustness testing", "source": "Common practice", "stage": "test", "spectrum": 0.85, "independent": false,
      "cost": 12, "weeks": 3,
      "coverage": {"safety": 0.4, "transparency": 0.05, "fairness": 0.1, "accountability": 0, "contestability": 0},
      "access": {"full": 1, "outputs": 1, "docs": 0},
      "model": {"rules": 1, "ml": 1, "genai": 0.7},
      "blurb": "Accuracy, error rates and behaviour on hard or shifted cases, measured against agreed thresholds."
    },
    {
      "id": "redteam", "name": "Independent red teaming", "source": "Common practice", "stage": "test", "spectrum": 0.6, "independent": true,
      "cost": 28, "weeks": 4,
      "coverage": {"safety": 0.45, "transparency": 0.05, "fairness": 0.15, "accountability": 0.05, "contestability": 0},
      "access": {"full": 1, "outputs": 1, "docs": 0},
      "model": {"rules": 0.5, "ml": 0.8, "genai": 1},
      "blurb": "Outside specialists try to make the system fail, leak or misbehave."
    },
    {
      "id": "formal", "name": "Formal verification", "source": "DSIT", "stage": "test", "spectrum": 1, "independent": false,
      "cost": 55, "weeks": 10,
      "coverage": {"safety": 0.6, "transparency": 0, "fairness": 0.05, "accountability": 0.05, "contestability": 0},
      "access": {"full": 1, "outputs": 0, "docs": 0},
      "model": {"rules": 1, "ml": 0.4, "genai": 0},
      "blurb": "Mathematical proof that the system meets specific requirements. Practical for rules and small models only."
    },
    {
      "id": "explain", "name": "Explainability testing", "source": "Common practice", "stage": "test", "spectrum": 0.55, "independent": false,
      "cost": 9, "weeks": 3,
      "coverage": {"safety": 0.05, "transparency": 0.45, "fairness": 0.1, "accountability": 0.05, "contestability": 0.25},
      "access": {"full": 1, "outputs": 0.6, "docs": 0},
      "model": {"rules": 1, "ml": 1, "genai": 0.7},
      "blurb": "Checks that explanations are faithful to the model and that the people who get them understand them."
    },
    {
      "id": "compliance", "name": "Compliance audit", "source": "DSIT", "stage": "test", "spectrum": 0.5, "independent": false,
      "cost": 14, "weeks": 3,
      "coverage": {"safety": 0.1, "transparency": 0.15, "fairness": 0.15, "accountability": 0.4, "contestability": 0.2},
      "blurb": "Reviews adherence to internal policies, regulations and legal requirements."
    },
    {
      "id": "conformity", "name": "Independent conformity assessment", "source": "DSIT", "stage": "test", "spectrum": 0.7, "independent": true,
      "cost": 38, "weeks": 8,
      "coverage": {"safety": 0.3, "transparency": 0.25, "fairness": 0.2, "accountability": 0.35, "contestability": 0.1},
      "access": {"full": 1, "outputs": 0.7, "docs": 0.4},
      "requires": ["docs"],
      "blurb": "Shows whether the system meets a set of requirements, such as a standard, before it goes live. Needs documentation."
    },
    {
      "id": "appeals", "name": "Appeal and redress test", "source": "Common practice", "stage": "test", "spectrum": 0.35, "independent": false,
      "cost": 6, "weeks": 2,
      "coverage": {"safety": 0, "transparency": 0.1, "fairness": 0.1, "accountability": 0.15, "contestability": 0.55},
      "blurb": "Walks real cases through the route for challenging an outcome and getting human review and a remedy."
    },
    {
      "id": "monitor", "name": "Live monitoring and incident response", "source": "Common practice", "stage": "live", "spectrum": 0.9, "independent": false,
      "cost": 15, "weeks": 0,
      "coverage": {"safety": 0.3, "transparency": 0.05, "fairness": 0.25, "accountability": 0.15, "contestability": 0.3},
      "access": {"full": 1, "outputs": 0.8, "docs": 0.8},
      "blurb": "Watches drift, errors and complaints after go-live, with a plan for when something goes wrong. Cost is the first year."
    }
  ],
  "defaults": {
    "answers": {"stakes": "significant", "autonomy": "approves", "model": "ml", "data": "personal", "affected": "public", "source": "outputs", "change": "retrained", "stage": "rollout"},
    "appetite": 8,
    "budget": 150,
    "weeks": 20,
    "legalMust": true
  },
  "appetitePresets": [
    {"value": 4, "label": "Cautious"},
    {"value": 8, "label": "Balanced"},
    {"value": 12, "label": "Tolerant"}
  ],
  "examples": [
    {
      "id": "shortlister", "name": "CV shortlister",
      "blurb": "A bought-in model that ranks job applicants for a national retailer's recruiters.",
      "answers": {"stakes": "significant", "autonomy": "approves", "model": "ml", "data": "personal", "affected": "public", "source": "outputs", "change": "retrained", "stage": "rollout"}
    },
    {
      "id": "billing", "name": "Billing assistant",
      "blurb": "A generative chat assistant that answers customers' billing questions for an energy supplier.",
      "answers": {"stakes": "shapes", "autonomy": "automated", "model": "genai", "data": "personal", "affected": "customers", "source": "outputs", "change": "fixed", "stage": "scale"}
    },
    {
      "id": "maintenance", "name": "Predictive maintenance",
      "blurb": "An in-house model that tells engineers which machines on a production line to service first.",
      "answers": {"stakes": "safety", "autonomy": "suggests", "model": "ml", "data": "none", "affected": "staff", "source": "inhouse", "change": "retrained", "stage": "scale"}
    },
    {
      "id": "fraud", "name": "Payment fraud flags",
      "blurb": "An in-house model that holds suspicious card payments for a lender's review team.",
      "answers": {"stakes": "shapes", "autonomy": "approves", "model": "ml", "data": "personal", "affected": "customers", "source": "inhouse", "change": "retrained", "stage": "scale"}
    },
    {
      "id": "policy", "name": "Policy search assistant",
      "blurb": "A generative assistant, still in pilot, that helps staff find and summarise internal policies.",
      "answers": {"stakes": "advisory", "autonomy": "suggests", "model": "genai", "data": "personal", "affected": "staff", "source": "outputs", "change": "fixed", "stage": "pilot"}
    },
    {
      "id": "grant", "name": "Hardship grant checker",
      "blurb": "Rules that decide eligibility for a local authority's hardship grant from application answers.",
      "answers": {"stakes": "significant", "autonomy": "automated", "model": "rules", "data": "special", "affected": "public", "source": "full", "change": "fixed", "stage": "scale"}
    }
  ]
}
